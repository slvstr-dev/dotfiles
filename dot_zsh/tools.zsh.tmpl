# Misc
precmd() { precmd() { echo "" } }

eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"

# Homebrew
export HOMEBREW_NO_ENV_HINTS=1

_brewfile() {
  if ! command -v brew &> /dev/null; then
    echo "🍺 Homebrew not found. Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || {
      echo "🚫 Failed to install Homebrew" >&2
      return 1
    }
    eval "$(/opt/homebrew/bin/brew shellenv zsh)"
  fi
  brew bundle "${@}" --file="$HOME/Brewfile"
}

_brew_doctor() {
  echo "🩺 Running brew doctor..."
  brew doctor
}

brew:install() {
  echo "📦 Installing Brewfile..."
  _brewfile install && _brew_doctor
  echo "✅ Done!"
}

brew:update() {
  echo "🔄 Updating Brewfile..."
  _brewfile install --upgrade && _brew_doctor
  echo "✅ Done!"
}

brew:cleanup() {
  echo "🧹 Cleaning up Brewfile..."
  _brewfile cleanup --force && brew autoremove && _brew_doctor
  echo "✅ Done!"
}

brew:uninstall() {
  echo "⚠️ This will uninstall ALL brew packages. Continue? (y/N)"
  read -r confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || return 0
  echo "🗑️ Uninstalling..."
  local formulae=($(brew list --formula))
  [[ ${#formulae[@]} -gt 0 ]] && brew uninstall --force "${formulae[@]}"
  local casks=($(brew list --cask))
  [[ ${#casks[@]} -gt 0 ]] && brew uninstall --cask --force "${casks[@]}"
  brew autoremove
  echo "✅ Done!"
}

{{ if eq .setup_type "work" }}
# Docker Sandbox
export SBX_NO_TELEMETRY=1

sbx:skills() { sbx skills import --force }

# Herdr
_herdr_panes() {
  local res=$1 cwd=$2 spec
  local ws=$(jq -r '.result.workspace.workspace_id' <<<$res)
  shift 2

  herdr tab rename $(jq -r '.result.tab.tab_id' <<<$res) lazygit >/dev/null
  herdr pane run $(jq -r '.result.root_pane.pane_id' <<<$res) lg >/dev/null

  for spec in $@; do
    herdr pane run $(herdr tab create --workspace $ws --cwd $cwd --label ${spec%%=*} --no-focus \
      | jq -r '.result.root_pane.pane_id') ${spec#*=} >/dev/null
  done
}

_herdr_branch() {
  local repo=$1 branch=$2
  git -C $repo fetch --quiet origin $branch 2>/dev/null
  git -C $repo show-ref --quiet --verify refs/heads/$branch && return
  git -C $repo show-ref --quiet --verify refs/remotes/origin/$branch && return
  print -u2 "${repo:t}: branch $branch not found locally or on origin"
  return 1
}

_herdr_checkout() {
  local label=$1 repo=$2 branch=$3 cmd=$4 cur res
  local ws=$(herdr workspace list | jq -r --arg l $label \
    '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)

  if [[ -n $ws ]]; then
    herdr workspace focus $ws >/dev/null
    cur=$(git -C $repo symbolic-ref --short HEAD 2>/dev/null)
    [[ $cur == $branch ]] || print -u2 "$label already open on $cur; ignoring $branch"
    return
  fi

  _herdr_branch $repo $branch || return 1
  res=$(herdr workspace create --cwd $repo --label $label --focus)
  _herdr_panes $res $repo "scripts=git switch $branch && $cmd"
}

_herdr_client() {
  local branch=$1 repo={{ .client_repo_path }} res
  local -a base

  _herdr_branch $repo $branch || return 1
  git -C $repo show-ref --quiet --verify refs/heads/$branch || base=(--base origin/$branch)

  res=$(herdr worktree open --cwd $repo --branch $branch --label $branch --focus 2>/dev/null) ||
    res=$(herdr worktree create --cwd $repo --branch $branch $base --label $branch --focus) || return 1

  [[ $(jq -r '.result.already_open // false' <<<$res) == true ]] && return
  _herdr_panes $res $(jq -r '.result.worktree.path' <<<$res) 'scripts=setup:client' 'agent=herdr:claude'
}

_herdr_repo() {
  local label=$1 repo=$2 res ws
  ws=$(herdr workspace list | jq -r --arg l $label \
    '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)

  if [[ -n $ws ]]; then
    herdr workspace focus $ws >/dev/null
    return
  fi

  res=$(herdr workspace create --cwd $repo --label $label --focus)
  _herdr_panes $res $repo 'agent=herdr:claude'
}

herdr:claude() {
  case ${PWD:A} in
    $HOME|/) print -u2 "herdr:claude: refusing to mount ${PWD:A}; cd into a project first"; return 1 ;;
  esac

  if [[ -z $HERDR_PANE_ID ]]; then
    local label=${PWD:t} ws res
    ws=$(herdr workspace list | jq -r --arg l $label \
      '.result.workspaces[] | select(.label == $l) | .workspace_id' | head -1)

    if [[ -n $ws ]]; then
      herdr workspace focus $ws >/dev/null
    else
      res=$(herdr workspace create --cwd $PWD --label $label --focus)
      ws=$(jq -r '.result.workspace.workspace_id' <<<$res)
    fi

    herdr pane run $(herdr tab create --workspace $ws --cwd $PWD --label agent${1:+-$1} --no-focus \
      | jq -r '.result.root_pane.pane_id') "herdr:claude${1:+ $1}" >/dev/null
    return
  fi

  sbx:skills >/dev/null 2>&1

  HERDR_AGENT=claude sbx run claude --name "claude-${PWD:t}${1:+-$1}" \
    --kit ~/.config/sbx/kits/network \
    --kit ~/.config/sbx/kits/claude
}

herdr:setup() {
  local -A default=(shared main app develop client develop client-repo 1)
  local -A want
  local t

  while (( $# )); do
    t=${1#--}
    [[ $1 == --* && -n ${default[$t]} ]] || { print -u2 "herdr:setup: unknown option $1"; return 1 }
    if [[ -n $2 && $2 != --* ]]; then want[$t]=$2; shift 2; else want[$t]=${default[$t]}; shift; fi
  done

  for t in shared app client client-repo; do
    [[ -n ${want[$t]} ]] || want[$t]=${default[$t]}
  done

  for t in shared app client client-repo; do
    case $t in
      shared)       _herdr_checkout medicore-shared-services {{ .shared_services_path }} ${want[$t]} 'make start' ;;
      app)          _herdr_checkout mcepd-app {{ .app_repo_path }} ${want[$t]} 'setup:app && make tool-vecozo-mock-start' ;;
      client)       _herdr_client ${want[$t]} ;;
      client-repo)  _herdr_repo mcepd-client-repo {{ .client_repo_path }} ;;
    esac
  done
}
