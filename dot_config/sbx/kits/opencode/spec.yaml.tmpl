schemaVersion: "2"
kind: mixin
name: opencode-config
displayName: OpenCode
description: OpenCode sandbox configuration
requires:
  agent: opencode
permissions:
  network:
    allow:
      - api.openai.com:443
      - auth.openai.com:443
      - chatgpt.com:443
      - models.dev:443
setup:
  files:
    - path: /home/agent/.config/opencode/opencode.json
      mode: "0644"
      description: OpenCode settings (provider, default agent, permissions, sharing disabled)
      content: |
        {
          "$schema": "https://opencode.ai/config.json",
          "default_agent": "plan",
          "enabled_providers": ["openai"],
          "permission": {
            "bash": {
              "*": "allow",
              {{ includeTemplate "opencode/bash-deny.tmpl" | indent 14 | trim }},
              "yarn": "deny",
              "yarn install*": "deny",
              "yarn add *": "deny",
              "npm i*": "deny",
              "npm install*": "deny",
              "npm ci*": "deny",
              "npm add *": "deny",
              "pnpm i*": "deny",
              "pnpm install*": "deny",
              "pnpm add *": "deny",
              "bun i*": "deny",
              "bun install*": "deny",
              "bun add *": "deny",
              "*nx build*": "deny",
              "*nx run*": "deny",
              "curl *": "deny",
              "curl http://host.docker.internal:9000*": "allow"
            },
            "read": {
              "*": "allow",
              {{ includeTemplate "opencode/path-deny.tmpl" | indent 14 | trim }}
            },
            "edit": {
              "*": "allow",
              {{ includeTemplate "opencode/path-deny.tmpl" | indent 14 | trim }},
              "**/.config/opencode/opencode.json": "deny"
            },
            "external_directory": "ask"
          },
          "share": "disabled"
        }
