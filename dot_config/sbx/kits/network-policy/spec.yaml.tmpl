schemaVersion: "2"
kind: mixin
name: network-policy
displayName: Network policy
description: Shared network policy
permissions:
  network:
    allow:
      # anthropic (the medicore MCP server is reached as a claude.ai connector,
      # proxied via claude.ai, so it needs no rule of its own; allowedMcpServers
      # in the claude kit keeps every other connector out)
      - api.anthropic.com:443
      - platform.claude.com:443
      - claude.ai:443
      # registries
      - registry.npmjs.org:443
      - registry.yarnpkg.com:443
      # host dev server, reached from the sandbox as host.docker.internal:9000
      # (the proxy rewrites the host to localhost before matching this rule)
      - localhost:9000
