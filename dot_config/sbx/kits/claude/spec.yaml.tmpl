schemaVersion: "2"
kind: mixin
name: claude-config
displayName: Claude Code
description: Claude Code sandbox configuration
requires:
  agent: claude
environment:
  variables:
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC: "1"
setup:
  files:
    - path: /home/agent/.claude/settings.json
      mode: "0644"
      description: Claude Code user settings (MCP, permissions, status line, TUI)
      content: |
        {
          "allowedMcpServers": [
            {{ includeTemplate "claude/mcp-servers.tmpl" | indent 12 | trim }}
          ],
          "outputStyle": "Concise",
          "permissions": {
            "defaultMode": "auto",
            "allow": [
              "Bash(curl http://host.docker.internal:9000*)"
            ],
            "deny": [
              {{ includeTemplate "claude/permissions.tmpl" | indent 14 | trim }},
              "Bash(yarn)",
              "Bash(yarn install*)",
              "Bash(yarn add *)",
              "Bash(npm i*)",
              "Bash(npm install*)",
              "Bash(npm ci*)",
              "Bash(npm add *)",
              "Bash(pnpm i*)",
              "Bash(pnpm install*)",
              "Bash(pnpm add *)",
              "Bash(bun i*)",
              "Bash(bun install*)",
              "Bash(bun add *)",
              "Bash(*nx build*)",
              "Bash(*nx run*)"
            ]
          },
          "statusLine": {
            "type": "command",
            "command": "jq -r --arg s \"$SANDBOX_NAME\" '\"[\\($s)] Context window usage: \\(.context_window.total_input_tokens // 0) of \\(.context_window.context_window_size) tokens (\\(.context_window.used_percentage // 0)%)\"'"
          },
          "tui": "fullscreen"
        }
