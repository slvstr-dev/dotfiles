{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "enabled_providers": ["openai"],
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "mui": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--ignore-scripts",
        "--min-release-age=7",
        "@mui/mcp@latest"
      ],
      "enabled": false
    }
  },
  "model": "openai/gpt-5.6-sol",
  "share": "disabled"
}
