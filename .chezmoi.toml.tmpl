{{- $profile := promptChoiceOnce . "profile" "Profile" (list "work" "personal") -}}

{{- $work := dict
      "mcp_url"      "MCP url"
      "setup_app"    "setup:app alias"
      "setup_client" "setup:client alias"
      "bundle_path"    "Bundle vault path (absolute)"
-}}

[data]
profile = {{ $profile | quote }}

{{- if eq $profile "work" }}
{{-   range $key, $question := $work }}
{{-     $value := or (dig $key "" $) (promptString $question) }}
{{-     if not $value }}{{ fail (print $question " is required") }}{{ end }}
{{ $key }} = {{ $value | quote }}
{{-   end }}
{{- end }}
