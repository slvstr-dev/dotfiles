{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowedMcpServers": [
    { "serverUrl": "https://mcp.figma.com/mcp" },
    { "serverUrl": {{ .mcp_url | quote }} }
  ],
  "autoMemoryEnabled": false,
  "enabledPlugins": {
    "medicore-frontend@synced": true,
    "medicore-misc@synced": true,
    "medicore-productivity@synced": true
  },
  "env": {
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1"
  },
  "outputStyle": "Concise",
  "permissions": {
    "additionalDirectories": [{{ .bundle_path | quote }}],
    "allow": [
      "WebSearch",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:yarnpkg.com)"
    ],
    "ask": [
      "Bash(*bun publish*)",
      "Bash(*bun x *)",
      "Bash(*bunx *)",
      "Bash(*dlx *)",
      "Bash(*nlx *)",
      "Bash(*npm adduser*)",
      "Bash(*npm exec *)",
      "Bash(*npm login*)",
      "Bash(*npm publish*)",
      "Bash(*npm x *)",
      "Bash(*npx *)",
      "Bash(*nx build*)",
      "Bash(*nx run*)",
      "Bash(*pip* install*)",
      "Bash(*pipx *)",
      "Bash(*uvx *)",
      "Bash(*yarn publish*)",
      "Bash(brew bundle*)",
      "Bash(brew install*)",
      "Bash(brew reinstall*)",
      "Bash(brew tap *)",
      "Bash(brew upgrade*)",
      "Bash(bun add *)",
      "Bash(bun create *)",
      "Bash(bun i*)",
      "Bash(bun up*)",
      "Bash(cargo binstall*)",
      "Bash(cargo install*)",
      "Bash(chezmoi * -a*)",
      "Bash(chezmoi *apply*)",
      "Bash(chezmoi *update*)",
      "Bash(chezmoi git *)",
      "Bash(corepack *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(gem install*)",
      "Bash(go install*)",
      "Bash(go run *@*)",
      "Bash(mise exec *)",
      "Bash(mise install*)",
      "Bash(mise plugins install*)",
      "Bash(mise self-update*)",
      "Bash(mise trust*)",
      "Bash(mise up*)",
      "Bash(mise use *)",
      "Bash(mise x *)",
      "Bash(ni *)",
      "Bash(npm add *)",
      "Bash(npm ci*)",
      "Bash(npm create *)",
      "Bash(npm i*)",
      "Bash(npm up*)",
      "Bash(pnpm add *)",
      "Bash(pnpm create *)",
      "Bash(pnpm i*)",
      "Bash(pnpm up*)",
      "Bash(rm -*)",
      "Bash(uv add *)",
      "Bash(uv pip sync*)",
      "Bash(uv python install*)",
      "Bash(uv self *)",
      "Bash(uv sync*)",
      "Bash(uv tool install*)",
      "Bash(uv tool run*)",
      "Bash(uv tool upgrade*)",
      "Bash(yarn add *)",
      "Bash(yarn create *)",
      "Bash(yarn global *)",
      "Bash(yarn install*)",
      "Bash(yarn up*)",
      "Bash(yarn)",
      "Edit(~/.local/share/chezmoi/.chezmoi*)",
      "Edit(~/.local/share/chezmoi/Brewfile*)",
      "Edit(~/.local/share/chezmoi/dot_*)",
      "Edit(~/.local/share/chezmoi/dot_*/**)",
      "Edit(~/.local/share/chezmoi/run_*)"
    ],
    "deny": [
      "Bash(crontab *)",
      "Bash(git branch -D*)",
      "Bash(git branch* --delete* --force*)",
      "Bash(git branch* -f *)",
      "Bash(git checkout --force*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout* -- *)",
      "Bash(git checkout* .)",
      "Bash(git clean *)",
      "Bash(git push* +*)",
      "Bash(git push* --delete*)",
      "Bash(git push* --force*)",
      "Bash(git push* --mirror*)",
      "Bash(git push* -d *)",
      "Bash(git push* -f*)",
      "Bash(git push* :*)",
      "Bash(git rebase *)",
      "Bash(git reset* --hard*)",
      "Bash(git restore *)",
      "Bash(git stash clear*)",
      "Bash(git stash drop*)",
      "Bash(git switch* --discard-changes*)",
      "Bash(git switch* -f*)",
      "Bash(git worktree prune*)",
      "Bash(git worktree remove*)",
      "Bash(launchctl *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Edit(//**/*.key)",
      "Edit(//**/*.p12)",
      "Edit(//**/*.pem)",
      "Edit(//**/.claude.json)",
      "Edit(//**/.claude/agents/**)",
      "Edit(//**/.claude/commands/**)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/plugins/**)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.claude/skills/**)",
      "Edit(//**/.env*)",
      "Edit(//**/.mcp.json)",
      "Edit(//**/id_ed25519*)",
      "Edit(//**/id_rsa*)",
      "Edit(//**/secrets/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.azure/**)",
      "Edit(~/.bash_profile)",
      "Edit(~/.bashrc)",
      "Edit(~/.claude/.config.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.config/gh/hosts.yml)",
      "Edit(~/.docker/**)",
      "Edit(~/.git-credentials)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.profile)",
      "Edit(~/.ssh/**)",
      "Edit(~/.zprofile)",
      "Edit(~/.zshrc)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pem)",
      "Read(//**/.env*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_rsa*)",
      "Read(//**/secrets/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Read(~/.claude/.config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.docker/**)",
      "Read(~/.git-credentials)",
      "Read(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.profile)",
      "Read(~/.ssh/**)",
      "Read(~/.zprofile)",
      "Read(~/.zshrc)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "credentials": {
      "envVars": [
        {
          "mode": "deny",
          "name": "ANTHROPIC_API_KEY"
        },
        {
          "mode": "deny",
          "name": "AWS_ACCESS_KEY_ID"
        },
        {
          "mode": "deny",
          "name": "AWS_SECRET_ACCESS_KEY"
        },
        {
          "mode": "deny",
          "name": "AWS_SESSION_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GH_TOKEN"
        },
        {
          "mode": "deny",
          "name": "GITHUB_TOKEN"
        },
        {
          "mode": "deny",
          "name": "NPM_TOKEN"
        },
        {
          "mode": "deny",
          "name": "OPENAI_API_KEY"
        }
      ]
    },
    "enabled": true,
    "excludedCommands": [
      "docker *",
      "docker-compose *"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "allowWrite": [
        "~/.bun/install/cache",
        "~/.npm/_cacache"
      ],
      "denyWrite": [
        "~/.local/share/chezmoi/.chezmoi*",
        "~/.local/share/chezmoi/Brewfile*",
        "~/.local/share/chezmoi/dot_*",
        "~/.local/share/chezmoi/run_*"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ],
      "strictAllowlist": true
    }
  },
  "theme": "auto"
}
