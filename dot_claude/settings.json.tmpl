{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "allowedMcpServers": [
    {{ includeTemplate "claude/mcp-servers.tmpl" | indent 4 | trim }}
  ],
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "outputStyle": "Concise",
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "WebSearch",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:yarnpkg.com)"
    ],
    "deny": [
      {{ includeTemplate "claude/permissions.tmpl" | indent 6 | trim }},
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(sudo *)",
      "Bash(su *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["docker *"],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": [
        "registry.npmjs.org",
        "registry.yarnpkg.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.azure",
        "~/.docker",
        "~/.npmrc",
        "~/.ssh",
        "**/.env*",
        "**/*.key",
        "**/*.pem",
        "**/secrets"
      ],
      "allowWrite": [
        "~/.bun/install/cache",
        "~/.cache",
        "~/.npm"
      ]
    }
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"Context window usage: \\(.context_window.total_input_tokens // 0) of \\(.context_window.context_window_size) tokens (\\(.context_window.used_percentage // 0)%)\"'"
  },
  "tui": "fullscreen"
}
