{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:bun.sh)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:developer.mozilla.org)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:mui.com)",
      "WebFetch(domain:nodejs.org)",
      "WebFetch(domain:npmjs.com)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:yarnpkg.com)"
    ],
    "deny": [
      "Bash(crontab *)",
      "Bash(launchctl *)",
      "Bash(su *)",
      "Bash(sudo *)",
      "Bash(git branch -D*)",
      "Bash(git checkout -f*)",
      "Bash(git checkout --force*)",
      "Bash(git clean *)",
      "Bash(git rebase)",
      "Bash(git rebase *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git worktree prune*)",
      "Bash(git worktree remove*)",
      "Bash(rm -- *)",
      "Bash(rm -f*)",
      "Bash(rm -r*)",
      "Edit(//**/.claude.json)",
      "Edit(//**/.claude/agents/**)",
      "Edit(//**/.claude/commands/**)",
      "Edit(//**/.claude/hooks/**)",
      "Edit(//**/.claude/plugins/**)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.claude/skills/**)",
      "Edit(//**/.mcp.json)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.azure/**)",
      "Edit(~/.azure/**)",
      "Read(~/.docker/**)",
      "Edit(~/.docker/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.bash_profile)",
      "Edit(~/.bash_profile)",
      "Read(~/.bashrc)",
      "Edit(~/.bashrc)",
      "Read(~/.claude/.config.json)",
      "Edit(~/.claude/.config.json)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Edit(~/.config/gh/hosts.yml)",
      "Read(~/.git-credentials)",
      "Edit(~/.git-credentials)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(~/.npmrc)",
      "Read(~/.profile)",
      "Edit(~/.profile)",
      "Read(~/.zprofile)",
      "Edit(~/.zprofile)",
      "Read(~/.zshrc)",
      "Edit(~/.zshrc)",
      "Read(**/.env*)",
      "Edit(**/.env*)",
      "Read(**/*.key)",
      "Edit(**/*.key)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.pem)",
      "Edit(**/*.pem)",
      "Read(**/id_ed25519*)",
      "Edit(**/id_ed25519*)",
      "Read(**/id_rsa*)",
      "Edit(**/id_rsa*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)"
    ],
    "ask": ["Bash(docker *)", "Bash(docker-compose *)"],
    "defaultMode": "default"
  },
  "effortLevel": "xhigh",
  {{- with dig "mcp_url" "" . }}
  "allowedMcpServers": [{ "serverUrl": {{ . | quote }} }],
  {{- end }}
  "statusLine": {
    "type": "command",
    "command": "jq -r '\"Context window usage: \\(.context_window.total_input_tokens // 0) of \\(.context_window.context_window_size) tokens (\\(.context_window.used_percentage // 0)%)\"'"
  },
  "outputStyle": "Concise",
  "sandbox": {
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["registry.npmjs.org", "registry.yarnpkg.com"],
      "strictAllowlist": true
    },
    "excludedCommands": ["docker *", "docker-compose *"],
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "filesystem": {
      "allowWrite": ["~/.bun/install/cache", "~/.cache", "~/.npm"],
      "denyRead": [
        "~/.aws",
        "~/.azure",
        "~/.docker",
        "~/.gnupg",
        "~/.kube",
        "~/.ssh",
        "~/.bash_profile",
        "~/.bashrc",
        "~/.claude/.config.json",
        "~/.claude/.credentials.json",
        "~/.config/gh/hosts.yml",
        "~/.git-credentials",
        "~/.netrc",
        "~/.npmrc",
        "~/.profile",
        "~/.zprofile",
        "~/.zshrc",
        "**/.env*",
        "**/*.key",
        "**/*.p12",
        "**/*.pem",
        "**/id_ed25519*",
        "**/id_rsa*",
        "**/secrets/**"
      ]
    },
    "failIfUnavailable": true,
    "credentials": {
      "envVars": [
        { "name": "ANTHROPIC_API_KEY", "mode": "deny" },
        { "name": "AWS_ACCESS_KEY_ID", "mode": "deny" },
        { "name": "AWS_SECRET_ACCESS_KEY", "mode": "deny" },
        { "name": "AWS_SESSION_TOKEN", "mode": "deny" },
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "NPM_TOKEN", "mode": "deny" },
        { "name": "OPENAI_API_KEY", "mode": "deny" }
      ]
    }
  },
  "tui": "fullscreen"
}
