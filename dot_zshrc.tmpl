# PATH
export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"

# FPATH
FPATH="/opt/homebrew/share/zsh/site-functions:${FPATH}"
FPATH="${HOME}/.zsh:${FPATH}"

# Environment
export EDITOR="zed --wait"
export VISUAL="zed --wait"
export EZA_CONFIG_DIR="$HOME/.config/eza"
export GPG_TTY=$(tty)
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=1000000000
export MANWIDTH=999
export SAVEHIST=$HISTSIZE
export STARSHIP_CONFIG=$HOME/.config/starship/starship.toml
export XDG_CONFIG_HOME="$HOME/.config"
{{- if eq .machine_type "work" }}
export SBX_NO_TELEMETRY=1
{{- end }}

# Completions
autoload -Uz compinit
if [[ ! -f "$HOME/.zcompdump" ]] || [[ $(find "$HOME/.zcompdump" -mtime +1 2>/dev/null) ]]; then
  compinit
else
  compinit -C
fi

# Aliases
alias df='cd ~/.local/share/chezmoi'
alias lg='lazygit'
alias ls='eza --icons=auto'
{{- if eq .machine_type "work" }}
alias install:be="git pull && make install-backend && make build-frontend-dojo && make run-migrations && make install-assets"
alias install:fe="yarn install && yarn nx reset && yarn cache clean && yarn install && yarn build:dev --exclude @medicore/mc-app && yarn start"

alias cc='claude'
alias oc='opencode'
alias sbx:cc='n=claude-$(basename "$PWD"); sbx create claude . --kit ~/repos/mcai-sbx-kits/mixins/network-policy --name $n; sbx exec $n -- mkdir -p /home/agent/.claude; sbx cp ~/.agents/skills $n:/home/agent/.claude/; sbx cp ~/.claude/settings.json $n:/home/agent/.claude/; sbx run --name $n'
alias sbx:oc='n=opencode-$(basename "$PWD"); sbx create opencode . --kit ~/repos/mcai-sbx-kits/m
{{- end }}

# Homebrew
export HOMEBREW_NO_ENV_HINTS=1

_brewfile() {
  if ! command -v brew &> /dev/null; then
    echo "🍺 Homebrew not found. Installing..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" || {
      echo "🚫 Failed to install Homebrew" >&2
      return 1
    }
    eval "$(/opt/homebrew/bin/brew shellenv)"
  fi
  brew bundle "${@}" --file="$HOME/Brewfile"
}
_brew_doctor() {
  echo "🩺 Running brew doctor..."
  brew doctor
}
brew:install() {
  echo "📦 Installing Brewfile..."
  _brewfile install && _brew_doctor
  echo "✅ Done!"
}
brew:update() {
  echo "🔄 Updating Brewfile..."
  _brewfile install --upgrade && _brew_doctor
  echo "✅ Done!"
}
brew:cleanup() {
  echo "🧹 Cleaning up Brewfile..."
  _brewfile cleanup --force && brew autoremove && _brew_doctor
  echo "✅ Done!"
}
brew:uninstall() {
  echo "⚠️ This will uninstall ALL brew packages. Continue? (y/N)"
  read -r confirm
  [[ "$confirm" =~ ^[Yy]$ ]] || return 0
  echo "🗑️ Uninstalling..."
  local formulae=($(brew list --formula))
  [[ ${#formulae[@]} -gt 0 ]] && brew uninstall --force "${formulae[@]}"
  local casks=($(brew list --cask))
  [[ ${#casks[@]} -gt 0 ]] && brew uninstall --cask --force "${casks[@]}"
  brew autoremove
  echo "✅ Done!"
}

# Options
unsetopt BEEP
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt SHARE_HISTORY
touch ~/.hushlogin

# Prompt
precmd() { precmd() { echo "" } }

# SSH
if [[ -z "$SSH_AUTH_SOCK" || ! -S "$SSH_AUTH_SOCK" ]]; then
  eval "$(ssh-agent -s)"
fi
ssh-add -l &> /dev/null || ssh-add

# Tools
eval "$(mise activate zsh)"
eval "$(starship init zsh)"
eval "$(zoxide init zsh)"
